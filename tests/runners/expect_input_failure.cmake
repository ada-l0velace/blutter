if(NOT DEFINED TEST_EXECUTABLE OR NOT DEFINED TEST_DIRECTORY)
    message(FATAL_ERROR "A native executable and scratch directory are required")
endif()

file(REMOVE_RECURSE "${TEST_DIRECTORY}")
file(MAKE_DIRECTORY "${TEST_DIRECTORY}")
file(WRITE "${TEST_DIRECTORY}/short-input" "synthetic")
foreach(input IN ITEMS missing-input short-input)
    set(output_directory "${TEST_DIRECTORY}/${input}-output")
    execute_process(COMMAND "${TEST_EXECUTABLE}" -i "${TEST_DIRECTORY}/${input}" -o "${output_directory}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 30)
    if(NOT "${result}" STREQUAL "1")
        message(FATAL_ERROR "Expected a reported input failure, got ${result}: ${output}${errors}")
    endif()
    if(NOT "${errors}" MATCHES "exception:.*[Ii]nput file")
        message(FATAL_ERROR "Missing input-failure diagnostic: ${output}${errors}")
    endif()
    file(READ "${output_directory}/analysis_status.json" status)
    string(JSON state GET "${status}" status)
    if(NOT state STREQUAL "failed" OR EXISTS "${output_directory}/asm" OR EXISTS "${output_directory}/pp.txt")
        message(FATAL_ERROR "Unsafe input must not be exported: ${status}")
    endif()
endforeach()
